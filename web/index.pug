mixin email(email)
  a(href="mailto:" data-email=btoa(email) onclick="this.href='mailto:' + atob(this.dataset.email)")=[...email].reverse().join('')

doctype html
html(lang="en")
  head
    title=title
    meta(charset="utf-8")
    link(rel="icon" type="image/png" href="hacker.png")
    link(rel="stylesheet" href="style.css")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
  body
    h1 COMING SOON
      br
      +email(email)
