doctype html
html(lang="en")
  head
    title="codin.gg | " + (filename === "index.pug" ? "home" : filename.substring(0, filename.lastIndexOf('.')))
    meta(charset="utf-8")
    link(rel="icon" type="image/png" href="hacker.png")
    link(rel="stylesheet" href="typography.css")
    link(rel="stylesheet" href="animation.css")
    link(rel="stylesheet" href="style.css")
    link(rel="stylesheet" href="game-of-life.css")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    block head
    script(type="module" src="game-of-life.js")

    body
    game-of-life(cell-size="5" gap="2" tick-rate="150")
    header
      section
        a.logo(href="index.pug")
          figure
            img(src="hacker.png")
            figcaption
              //span.prefix *.
              | codin
              span.suffix .gg
                .particle.p1
                .particle.p2
                .particle.p3
                .particle.p4
        nav.lang
          a.active(href="#") EN
          a(href="#") IT
          a(href="#") DE
      section
        nav.menu
          a(href="index.pug") Home
          a(href="identity.pug") Identity
          a(href="software.pug") Software
          a(href="training.pug") Training
          a(href="events.pug") Events
          a(href="library.pug") Library
    block body
    footer
      .footer-legal
        a(href="index.pug") CODIN.GG
        | &#32; © 2026 IT02763680218
      .footer-nav
        a(href="privacy.pug") Privacy
        | &#32; |&#32;
        a(href="//github.com/codin-gg" target="_blank") Github ↗
